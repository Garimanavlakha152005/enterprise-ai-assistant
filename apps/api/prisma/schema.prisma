generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         UserRole        @default(EMPLOYEE)
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  expenses     Expense[]
  reimbursements Reimbursement[]
  aiActions    AIAction[]
  approvedReimbursements Reimbursement[] @relation("ReimbursementApprover")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([departmentId])
}

model Expense {
  id             String          @id @default(cuid())
  employeeId     String
  employee       User            @relation(fields: [employeeId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  category       String
  description    String
  expenseDate    DateTime
  status         ExpenseStatus   @default(SUBMITTED)
  reimbursement  Reimbursement?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([employeeId, expenseDate])
  @@index([category])
}

model Reimbursement {
  id         String               @id @default(cuid())
  expenseId  String               @unique
  expense    Expense              @relation(fields: [expenseId], references: [id])
  employeeId String
  employee   User                 @relation(fields: [employeeId], references: [id])
  amount     Decimal              @db.Decimal(12, 2)
  status     ReimbursementStatus  @default(PENDING)
  approvedBy String?
  approver   User?                @relation("ReimbursementApprover", fields: [approvedBy], references: [id])
  approvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([employeeId, status])
}

model AIAction {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  actionType  String
  parameters  Json
  status      AIActionStatus @default(PENDING_APPROVAL)
  result      Json?
  createdAt   DateTime       @default(now())
  approvedAt  DateTime?
  executedAt  DateTime?

  @@index([userId, createdAt])
  @@index([status])
}
